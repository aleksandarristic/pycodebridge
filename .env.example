# Required for bridge runtime
DISCORD_TOKEN=your_discord_bot_token_here

# Required for Docker/Compose repo mount
CODE_ROOT_HOST=/absolute/path/to/your/repos

# Optional but recommended host mounts
STATE_DIR_HOST=/absolute/path/to/pycodebridge-state
CODEX_AUTH_HOST=/absolute/path/to/codex-auth-dir
GH_CONFIG_HOST=/absolute/path/to/gh-config-dir

# Recommended on Linux (Compose user mapping)
HOST_UID=1000
HOST_GID=1000

# Optional for headless GitHub auth (alternative to gh auth login)
# GH_TOKEN=ghp_xxx
# GITHUB_TOKEN=ghp_xxx

# Optional if config.docker.yaml uses:
# git.global_config_path: "/workspace/state/gitconfig"
# GIT_CONFIG_GLOBAL=/workspace/state/gitconfig
